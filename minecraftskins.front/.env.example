# Разработка: адрес бэкенда для прокси Vite.
# Если задан, запросы с фронта к /api проксируются на этот адрес. Без значения прокси не используется.
# HTTP:  http://localhost:8080
# HTTPS: https://localhost:8081
VITE_DEV_API_ORIGIN=

# Продакшен/сборка: полный базовый URL API (при npm run build и при сборке Docker-образа).
# Пишите без пробелов и без точки с запятой в конце (в .env комментарии только через #).
# HTTP:  http://localhost:8080/api
# HTTPS: https://localhost:8081/api
# VITE_API_BASE_URL=
