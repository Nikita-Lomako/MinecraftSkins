{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId"
    ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": {
          "maximumDestructuringDepth": 4
        }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": {
          "maximumStringLength": 100
        }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": {
          "maximumCollectionCount": 10
        }
      }
    ],
    "Properties": {
      "Application": "MinecraftSkins.Api"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ 
      "http://localhost:3001", 
      "https://localhost:3001",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "ApiSettings": {
    "Secret": ""
  },
  "Redis": {
    "Configuration": ""
  },
  "BtcRateProvider": {
    "Provider": "CoinGecko"
  },
  "OpenTelemetry": {
    "Metrics": {
      "Enabled": true
    }
  },
  "QueryHistory": {
    "RetentionDays": 30,
    "MaxRows": 10000
  }
}
